// ThoxOS Desktop identity (TXF 5.2 surface 15): fastfetch says what this machine is.
{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "file",
    "source": "/usr/share/thox/txf/fastfetch-logo.txt",
    "color": { "1": "38;2;5;164;81" },
    "padding": { "right": 3 }
  },
  "display": { "separator": "  ", "color": { "keys": "38;2;5;164;81" } },
  "modules": [
    "title",
    "separator",
    { "type": "os", "key": "os" },
    { "type": "kernel", "key": "kernel" },
    { "type": "command", "key": "ginux", "text": "printf 'Ginux 6.12.0-ginux.0.1 runtime, host %s' \"$(cat /usr/share/thoxos-g/HOST_VERSION 2>/dev/null || echo unknown)\"" },
    { "type": "host", "key": "host" },
    { "type": "cpu", "key": "cpu" },
    { "type": "memory", "key": "memory" },
    { "type": "disk", "key": "disk", "folders": "/" },
    { "type": "de", "key": "desktop" },
    { "type": "command", "key": "look", "text": "thoxos-look current 2>/dev/null || echo slate" },
    { "type": "command", "key": "ai", "text": "thoxos-ai-chip 2>/dev/null | sed -E 's/.*> ([A-Z ]+) <.*/\\1/'" },
    { "type": "uptime", "key": "uptime" }
  ]
}
