#!/bin/bash
# Copyright (c) 2026 THOX.ai LLC. Licensed under the Apache License, Version 2.0.
# thoxos-hold: run a command in a terminal window, then keep the window open
# until Enter. Used instead of xfce4-terminal --hold, whose "child process
# exited" bar shrinks the terminal and scrolls the first lines out of view.
if [ "$#" -eq 0 ]; then
    echo "usage: thoxos-hold COMMAND [ARG...]" >&2
    exit 2
fi
"$@"
status=$?
printf '\n'
if [ "$status" -ne 0 ]; then
    printf 'Exited with status %d. ' "$status"
fi
read -r -p "Press Enter to close this window. " _ || true
exit "$status"
