# ThoxOS AI endpoint used by `thox ask`. Environment variables of the same name
# override these values per shell.
#
# 10.0.2.2 is the QEMU user-network alias for the host's loopback interface, so
# an OpenAI-compatible server listening on the host's 127.0.0.1:11434 (Ollama
# default port) is reachable from inside ThoxOS without opening it to the LAN.
THOX_AI_BASE_URL="http://10.0.2.2:11434/v1"

# Set the model name your endpoint serves, for example the model tag shown by
# `ollama list` on the host. Left unset on purpose: no model ships in this image.
#THOX_AI_MODEL=""

# Optional bearer token. If you set it here, keep this file mode 0600.
#THOX_AI_API_KEY=""

# Seconds to wait for a reply (1 to 3600).
THOX_AI_TIMEOUT="120"
