# THOX AI endpoint used by `thox ask` on this host. Environment variables of the
# same name override these values per shell.
#
# 127.0.0.1:11434 is the Ollama default port: a local model server on this host,
# or thox-ai-relay when hosted routing is configured (/etc/thoxos/ai-relay.env).
# ThoxOS on Ginux reaches the same port as 10.0.2.2:11434.
THOX_AI_BASE_URL="http://127.0.0.1:11434/v1"

# Set the model name your endpoint serves (for example from `ollama list`).
#THOX_AI_MODEL=""

# Seconds to wait for a reply (1 to 3600).
THOX_AI_TIMEOUT="120"
