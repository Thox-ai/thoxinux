[Unit]
Description=ThoxOS Ginux Edition DNS forwarder (127.0.0.1:53 for the Ginux guest)
Documentation=file:///usr/share/doc/thoxos-g/README.md
After=systemd-resolved.service network.target
Wants=systemd-resolved.service

[Service]
Type=simple
ExecStart=/usr/sbin/dnsmasq --keep-in-foreground --log-facility=- \
    --conf-file=/etc/thoxos-g/dnsmasq.conf \
    --resolv-file=/run/systemd/resolve/resolv.conf \
    --user=dnsmasq --pid-file=
Restart=on-failure
RestartSec=2
CapabilityBoundingSet=CAP_NET_BIND_SERVICE CAP_SETUID CAP_SETGID CAP_NET_RAW
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX AF_NETLINK

[Install]
WantedBy=multi-user.target
