# ThoxOS Desktop dock defaults (TXF 5.2: floating dock, tile 46). thoxos-look
# changes theme and position per look.
[net/launchpad/plank/docks/dock1]
theme='ThoxOS-Dark'
icon-size=46
position='bottom'
alignment='center'
hide-mode='none'
zoom-enabled=false
show-dock-item=false
