From 5840a69537e832b4ddfb62235204ea8bfc7cec7c Mon Sep 17 00:00:00 2001
From: Odette Lark <sadie@thox.ai>
Date: Wed, 28 Oct 2026 22:24:06 -0500
Subject: [PATCH 3/3] network: trust a per-build ThoxOS local registry anchor
 for one host

registry.thoxos.internal is verified against certs/thoxos-local-root.pem,
generated per build by the ThoxOS tooling. All other registries keep the
upstream trust anchors.
---
 services/network/src/registry.rs | 10 ++++++++++
 1 file changed, 10 insertions(+)

diff --git a/services/network/src/registry.rs b/services/network/src/registry.rs
index a0eb460..ba085b0 100644
--- a/services/network/src/registry.rs
+++ b/services/network/src/registry.rs
@@ -40,6 +40,10 @@ const NETWORK_POLL_LIMIT: usize = 25_000_000;
 const POLLS_PER_MILLISECOND: usize = 1024;
 const TLS_RECORD_SIZE: usize = 16_640;
 const CERTIFICATE_SIZE: usize = 4096;
+/// ThoxOS local registry name. Resolved by the ThoxOS host DNS forwarder to the
+/// QEMU user-network host alias, where the bundled registry serves ThoxOS
+/// userspace images over TLS.
+const THOXOS_LOCAL_REGISTRY_HOST: &str = "registry.thoxos.internal";
 const HTTP_HEADER_SIZE: usize = 8192;
 const METADATA_BODY_SIZE: usize = 64 * 1024;
 
@@ -955,8 +959,14 @@ unsafe fn https_get(
         return false;
     };
     progress(b"registry TCP connected");
+    // ThoxOS: the local registry trust anchor is accepted for exactly one host
+    // name. Every other registry keeps the upstream anchors unchanged. The PEM
+    // is generated per build by the ThoxOS tooling; its private key is
+    // discarded after signing the registry leaf certificate.
     let root = if host == "auth.docker.io" {
         include_str!("../certs/isrg-root-x1.pem")
+    } else if host == THOXOS_LOCAL_REGISTRY_HOST {
+        include_str!("../certs/thoxos-local-root.pem")
     } else {
         include_str!("../certs/starfield-services-root-g2.pem")
     };
