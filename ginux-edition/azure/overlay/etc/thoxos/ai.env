# THOX AI endpoint used by `thox ask` on this Azure host. Environment variables
# of the same name override these values per shell.
#
# 127.0.0.1:11434 is thox-ai-relay once /etc/thoxos/ai-relay.env is configured
# (hosted routing). "thox-hosted" asks the relay for its configured model.
# ThoxOS on Ginux reaches the relay as 10.0.2.2:11434 with the same model name.
THOX_AI_BASE_URL="http://127.0.0.1:11434/v1"
THOX_AI_MODEL="thox-hosted"
THOX_AI_TIMEOUT="120"
