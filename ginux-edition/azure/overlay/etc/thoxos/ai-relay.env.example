# THOX AI relay: hosted routing for `thox ask` on this VM and inside ThoxOS on Ginux.
#
# Copy to /etc/thoxos/ai-relay.env, then:
#   sudo chown root:thoxos-ai /etc/thoxos/ai-relay.env
#   sudo chmod 0640 /etc/thoxos/ai-relay.env
#   sudo systemctl restart thox-ai-relay
#
# The relay listens on loopback only and adds the credential, so neither users
# nor ThoxOS on Ginux ever hold it. Every local user shares this key and the
# rate limit below.

# OpenAI-compatible base URL (the part before /chat/completions). Examples:
#   Azure OpenAI (v1 API): https://<resource>.openai.azure.com/openai/v1   THOX_RELAY_AUTH=api-key
#   Anthropic (OpenAI SDK compatibility): https://api.anthropic.com/v1     THOX_RELAY_AUTH=bearer
THOX_RELAY_UPSTREAM=https://example.openai.azure.com/openai/v1
THOX_RELAY_AUTH=api-key
THOX_RELAY_API_KEY=replace-with-your-key
# Model or deployment name used when a client asks for "thox-hosted".
THOX_RELAY_MODEL=replace-with-your-deployment
THOX_RELAY_LISTEN=127.0.0.1:11434
THOX_RELAY_RATE_PER_MIN=30
THOX_RELAY_TIMEOUT=120
