{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
  "contentVersion": "0.2.0.0",
  "metadata": {
    "description": "ThoxOS Ginux Edition 0.2.0 on Azure: one Linux VM from the published gallery image (ThoxOS Desktop or headless), Ginux under nested KVM, RDP and SSH limited to one source range. Research preview: Ginux is unaudited.",
    "author": "THOX.ai LLC"
  },
  "parameters": {
    "vmName": {
      "type": "string",
      "defaultValue": "thoxos-ginux",
      "minLength": 1,
      "maxLength": 30,
      "metadata": { "description": "VM name and host name (letters, digits and hyphens, 30 characters or fewer)." }
    },
    "location": {
      "type": "string",
      "defaultValue": "[resourceGroup().location]",
      "metadata": { "description": "Region; must hold a replica of the image version." }
    },
    "imageVersionId": {
      "type": "string",
      "metadata": { "description": "Resource ID of the Azure Compute Gallery image version (or image definition for latest) printed by azure/publish-image.sh." }
    },
    "vmSize": {
      "type": "string",
      "defaultValue": "Standard_D4s_v5",
      "metadata": { "description": "Pick a size with nested virtualization so Ginux runs under KVM (Dsv5 family by default). Other sizes fall back to slow software emulation." }
    },
    "adminUsername": {
      "type": "string",
      "defaultValue": "thox",
      "metadata": { "description": "Administrator created by cloud-init; member of sudo and kvm." }
    },
    "authenticationType": {
      "type": "string",
      "defaultValue": "password",
      "allowedValues": [ "password", "sshPublicKey" ],
      "metadata": { "description": "password is needed for RDP desktop sign-in; sshPublicKey for headless images." }
    },
    "adminPasswordOrKey": {
      "type": "securestring",
      "metadata": { "description": "Administrator password (12+ characters, Azure complexity rules) or SSH public key." }
    },
    "allowedSourceCidr": {
      "type": "string",
      "metadata": { "description": "Only this source range reaches SSH and RDP, for example 203.0.113.7/32. Never use * or 0.0.0.0/0." }
    },
    "enableRdp": {
      "type": "bool",
      "defaultValue": true,
      "metadata": { "description": "Open 3389 for the ThoxOS Desktop (xrdp). Set false for headless images." }
    },
    "osDiskSizeGB": {
      "type": "int",
      "defaultValue": 64,
      "minValue": 30,
      "maxValue": 1023,
      "metadata": { "description": "The root partition grows to fill the disk on first boot." }
    },
    "desktopLook": {
      "type": "string",
      "defaultValue": "slate",
      "allowedValues": [ "slate", "porcelain", "console-pro" ],
      "metadata": { "description": "Default ThoxOS Desktop look for new users (TXF 5.2). Ignored on headless images." }
    },
    "aiUpstream": {
      "type": "string",
      "defaultValue": "",
      "metadata": { "description": "Optional hosted model for thox ask: OpenAI-compatible https base URL, for example https://RESOURCE.openai.azure.com/openai/v1. Empty leaves AI off." }
    },
    "aiAuth": {
      "type": "string",
      "defaultValue": "api-key",
      "allowedValues": [ "api-key", "bearer", "x-api-key" ],
      "metadata": { "description": "api-key for Azure OpenAI, bearer for OpenAI-compatible APIs such as Anthropic's compatibility endpoint." }
    },
    "aiApiKey": {
      "type": "securestring",
      "defaultValue": "",
      "metadata": { "description": "Key for aiUpstream. Stored root:thoxos-ai 0640 on the VM; prefer a Key Vault reference in the parameters file." }
    },
    "aiModel": {
      "type": "string",
      "defaultValue": "",
      "metadata": { "description": "Upstream model or deployment name served as thox-hosted." }
    }
  },
  "variables": {
    "nsgName": "[concat(parameters('vmName'), '-nsg')]",
    "vnetName": "[concat(parameters('vmName'), '-vnet')]",
    "subnetName": "default",
    "pipName": "[concat(parameters('vmName'), '-pip')]",
    "nicName": "[concat(parameters('vmName'), '-nic')]",
    "sshRule": [
      {
        "name": "ssh-from-allowed-source",
        "properties": {
          "priority": 1000,
          "direction": "Inbound",
          "access": "Allow",
          "protocol": "Tcp",
          "sourceAddressPrefix": "[parameters('allowedSourceCidr')]",
          "sourcePortRange": "*",
          "destinationAddressPrefix": "*",
          "destinationPortRange": "22"
        }
      }
    ],
    "rdpRule": [
      {
        "name": "rdp-from-allowed-source",
        "properties": {
          "priority": 1010,
          "direction": "Inbound",
          "access": "Allow",
          "protocol": "Tcp",
          "sourceAddressPrefix": "[parameters('allowedSourceCidr')]",
          "sourcePortRange": "*",
          "destinationAddressPrefix": "*",
          "destinationPortRange": "3389"
        }
      }
    ],
    "linuxConfiguration": {
      "disablePasswordAuthentication": true,
      "provisionVMAgent": true,
      "ssh": {
        "publicKeys": [
          {
            "path": "[concat('/home/', parameters('adminUsername'), '/.ssh/authorized_keys')]",
            "keyData": "[parameters('adminPasswordOrKey')]"
          }
        ]
      }
    },
    "passwordConfiguration": {
      "disablePasswordAuthentication": false,
      "provisionVMAgent": true
    },
    "firstBootScript": "[format('#!/bin/bash\n# ThoxOS Ginux Edition first-boot settings from the deployment (values arrive base64-encoded).\nset -eu\nlook=$(printf %s ''{0}'' | base64 -d)\nupstream=$(printf %s ''{1}'' | base64 -d)\nauth=$(printf %s ''{2}'' | base64 -d)\nkey=$(printf %s ''{3}'' | base64 -d)\nmodel=$(printf %s ''{4}'' | base64 -d)\nif command -v thoxos-look >/dev/null 2>&1; then thoxos-look system-default \"$look\"; fi\nif [ -n \"$upstream\" ] && [ -n \"$key\" ] && [ -n \"$model\" ]; then\n  umask 027\n  printf ''THOX_RELAY_UPSTREAM=%s\\nTHOX_RELAY_AUTH=%s\\nTHOX_RELAY_API_KEY=%s\\nTHOX_RELAY_MODEL=%s\\nTHOX_RELAY_LISTEN=127.0.0.1:11434\\nTHOX_RELAY_RATE_PER_MIN=30\\nTHOX_RELAY_TIMEOUT=120\\n'' \"$upstream\" \"$auth\" \"$key\" \"$model\" >/etc/thoxos/ai-relay.env\n  chown root:thoxos-ai /etc/thoxos/ai-relay.env\n  chmod 0640 /etc/thoxos/ai-relay.env\n  systemctl restart thox-ai-relay.service\nfi\n', base64(parameters('desktopLook')), base64(parameters('aiUpstream')), base64(parameters('aiAuth')), base64(parameters('aiApiKey')), base64(parameters('aiModel')))]"
  },
  "resources": [
    {
      "type": "Microsoft.Network/networkSecurityGroups",
      "apiVersion": "2023-09-01",
      "name": "[variables('nsgName')]",
      "location": "[parameters('location')]",
      "properties": {
        "securityRules": "[if(parameters('enableRdp'), concat(variables('sshRule'), variables('rdpRule')), variables('sshRule'))]"
      }
    },
    {
      "type": "Microsoft.Network/virtualNetworks",
      "apiVersion": "2023-09-01",
      "name": "[variables('vnetName')]",
      "location": "[parameters('location')]",
      "dependsOn": [
        "[resourceId('Microsoft.Network/networkSecurityGroups', variables('nsgName'))]"
      ],
      "properties": {
        "addressSpace": { "addressPrefixes": [ "10.40.0.0/16" ] },
        "subnets": [
          {
            "name": "[variables('subnetName')]",
            "properties": {
              "addressPrefix": "10.40.0.0/24",
              "networkSecurityGroup": { "id": "[resourceId('Microsoft.Network/networkSecurityGroups', variables('nsgName'))]" }
            }
          }
        ]
      }
    },
    {
      "type": "Microsoft.Network/publicIPAddresses",
      "apiVersion": "2023-09-01",
      "name": "[variables('pipName')]",
      "location": "[parameters('location')]",
      "sku": { "name": "Standard" },
      "properties": {
        "publicIPAllocationMethod": "Static",
        "dnsSettings": { "domainNameLabel": "[toLower(concat(parameters('vmName'), '-', uniqueString(resourceGroup().id)))]" }
      }
    },
    {
      "type": "Microsoft.Network/networkInterfaces",
      "apiVersion": "2023-09-01",
      "name": "[variables('nicName')]",
      "location": "[parameters('location')]",
      "dependsOn": [
        "[resourceId('Microsoft.Network/virtualNetworks', variables('vnetName'))]",
        "[resourceId('Microsoft.Network/publicIPAddresses', variables('pipName'))]"
      ],
      "properties": {
        "enableAcceleratedNetworking": false,
        "ipConfigurations": [
          {
            "name": "ipconfig1",
            "properties": {
              "privateIPAllocationMethod": "Dynamic",
              "subnet": { "id": "[resourceId('Microsoft.Network/virtualNetworks/subnets', variables('vnetName'), variables('subnetName'))]" },
              "publicIPAddress": { "id": "[resourceId('Microsoft.Network/publicIPAddresses', variables('pipName'))]" }
            }
          }
        ]
      }
    },
    {
      "type": "Microsoft.Compute/virtualMachines",
      "apiVersion": "2024-03-01",
      "name": "[parameters('vmName')]",
      "location": "[parameters('location')]",
      "dependsOn": [
        "[resourceId('Microsoft.Network/networkInterfaces', variables('nicName'))]"
      ],
      "properties": {
        "hardwareProfile": { "vmSize": "[parameters('vmSize')]" },
        "storageProfile": {
          "imageReference": { "id": "[parameters('imageVersionId')]" },
          "osDisk": {
            "createOption": "FromImage",
            "caching": "ReadWrite",
            "diskSizeGB": "[parameters('osDiskSizeGB')]",
            "managedDisk": { "storageAccountType": "Premium_LRS" },
            "deleteOption": "Delete"
          }
        },
        "osProfile": {
          "computerName": "[parameters('vmName')]",
          "adminUsername": "[parameters('adminUsername')]",
          "adminPassword": "[if(equals(parameters('authenticationType'), 'password'), parameters('adminPasswordOrKey'), null())]",
          "linuxConfiguration": "[if(equals(parameters('authenticationType'), 'password'), variables('passwordConfiguration'), variables('linuxConfiguration'))]",
          "customData": "[base64(variables('firstBootScript'))]"
        },
        "networkProfile": {
          "networkInterfaces": [
            {
              "id": "[resourceId('Microsoft.Network/networkInterfaces', variables('nicName'))]",
              "properties": { "deleteOption": "Delete" }
            }
          ]
        },
        "diagnosticsProfile": {
          "bootDiagnostics": { "enabled": true }
        }
      }
    }
  ],
  "outputs": {
    "fqdn": {
      "type": "string",
      "value": "[reference(resourceId('Microsoft.Network/publicIPAddresses', variables('pipName')), '2023-09-01').dnsSettings.fqdn]"
    },
    "publicIp": {
      "type": "string",
      "value": "[reference(resourceId('Microsoft.Network/publicIPAddresses', variables('pipName')), '2023-09-01').ipAddress]"
    },
    "ssh": {
      "type": "string",
      "value": "[concat('ssh ', parameters('adminUsername'), '@', reference(resourceId('Microsoft.Network/publicIPAddresses', variables('pipName')), '2023-09-01').dnsSettings.fqdn)]"
    },
    "rdp": {
      "type": "string",
      "value": "[if(parameters('enableRdp'), concat('mstsc /v:', reference(resourceId('Microsoft.Network/publicIPAddresses', variables('pipName')), '2023-09-01').dnsSettings.fqdn), 'RDP disabled')]"
    }
  }
}
