diff --git a/kernel/src/linux_stack.rs b/kernel/src/linux_stack.rs
new file mode 100644
index 0000000..564611f
--- /dev/null
+++ b/kernel/src/linux_stack.rs
@@ -0,0 +1,86 @@
+//! Checked layout for bounded Linux startup-stack verification fixtures.
+//!
+//! The fixed payload offsets are measured from the end of the mapped stack
+//! page. Reserve the actual auxiliary-vector length before that payload,
+//! rather than assuming an older set of AT_* entries.
+
+use core::mem::size_of;
+
+/// Return a 16-byte-aligned stack offset for argc, one argv pointer, its
+/// terminator, one envp pointer, its terminator, auxv, and trailing payload.
+/// None means the complete layout does not fit in the mapped stack page.
+pub(crate) fn fixture_stack_offset(
+    page_size: usize,
+    auxiliary_words: usize,
+    payload_words: usize,
+) -> Option<usize> {
+    if !page_size.is_multiple_of(16) {
+        return None;
+    }
+    let words = 5_usize
+        .checked_add(auxiliary_words)?
+        .checked_add(payload_words)?;
+    let aligned_words = words.checked_add(1)? & !1;
+    page_size.checked_sub(aligned_words.checked_mul(size_of::<u64>())?)
+}
+
+#[cfg(test)]
+mod tests {
+    use super::fixture_stack_offset;
+
+    #[test]
+    fn static_auxv_and_random_payload_do_not_overlap() {
+        let offset = fixture_stack_offset(4096, 40, 7).unwrap();
+        let payload_start = 4096 - 7 * 8;
+        assert_eq!(offset % 16, 0);
+        assert!(offset + (5 + 40) * 8 <= payload_start);
+
+        let mut page = [0_u8; 4096];
+        let mut auxv = [0_u64; 40];
+        auxv[36] = 33; // AT_SYSINFO_EHDR
+        for (index, word) in auxv.iter().enumerate() {
+            let start = offset + (5 + index) * 8;
+            page[start..start + 8].copy_from_slice(&word.to_le_bytes());
+        }
+        page[payload_start..payload_start + 16].fill(0xa5);
+        let read = |index: usize| {
+            u64::from_le_bytes(
+                page[offset + index * 8..offset + (index + 1) * 8]
+                    .try_into()
+                    .unwrap(),
+            )
+        };
+        assert_eq!([read(41), read(42), read(43), read(44)], [33, 0, 0, 0]);
+        assert_eq!(&page[payload_start..payload_start + 16], &[0xa5; 16]);
+    }
+
+    #[test]
+    fn interpreted_auxv_and_string_payload_do_not_overlap() {
+        let offset = fixture_stack_offset(4096, 40, 6).unwrap();
+        assert_eq!(offset % 16, 0);
+        assert!(offset + (5 + 40) * 8 <= 4096 - 6 * 8);
+    }
+
+    #[test]
+    fn auxiliary_vector_growth_preserves_payload_and_alignment() {
+        for auxiliary_words in 0..100 {
+            for payload_words in [0, 6, 7, 8] {
+                let offset = fixture_stack_offset(4096, auxiliary_words, payload_words).unwrap();
+                assert_eq!(offset % 16, 0);
+                assert!(offset + (5 + auxiliary_words) * 8 <= 4096 - payload_words * 8);
+            }
+        }
+    }
+
+    #[test]
+    fn too_large_layout_and_integer_overflow_are_rejected() {
+        assert_eq!(fixture_stack_offset(4096, 512, 7), None);
+        assert_eq!(fixture_stack_offset(4096, usize::MAX, 7), None);
+        assert_eq!(fixture_stack_offset(4096, 40, usize::MAX), None);
+    }
+
+    #[test]
+    fn misaligned_page_size_is_rejected() {
+        assert_eq!(fixture_stack_offset(4095, 40, 7), None);
+    }
+}
