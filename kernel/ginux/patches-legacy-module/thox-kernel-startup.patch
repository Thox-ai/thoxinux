+/// Route the resident controller to the operator console even when it is
+/// resumed from a detached embedded-domain supervisor.
+pub(crate) fn with_operator_console(operation: impl FnOnce() -> bool) -> bool {
+    let background = BACKGROUND_DOMAIN_OUTPUT.swap(false, Ordering::AcqRel);
+    let result = operation();
+    BACKGROUND_DOMAIN_OUTPUT.store(background, Ordering::Release);
+    result
+}
+
 fn serial_write(message: &str) {
     serial_write_bytes(message.as_bytes());
 }
